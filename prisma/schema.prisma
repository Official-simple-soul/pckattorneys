generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton row (id always "settings") holding theme + firm-wide identity/contact info.
model SiteSettings {
  id              String   @id @default("settings")
  firmName        String   @default("Parah, Chen and King Attorneys")
  shortName       String   @default("PCK Attorneys")
  tagline         String   @default("Turning legal complexity into strategic advantage.")
  logoText        String   @default("PCK")
  logoUrl         String   @default("")
  primaryColor    String   @default("#0B2545")
  secondaryColor  String   @default("#C9A227")
  accentColor     String   @default("#13315C")
  neutralColor    String   @default("#F7F5F0")
  radius          String   @default("md")
  headingFont     String   @default("libreCaslon")
  bodyFont        String   @default("sourceSans")
  phone           String   @default("+234 800 000 0000")
  email           String   @default("consult@pckattorneys.com")
  address         String   @default("Plot 123, Central Business District")
  city            String   @default("Abuja")
  country         String   @default("Nigeria")
  linkedinUrl     String   @default("")
  twitterUrl      String   @default("")
  officeHours     String   @default("Monday – Friday, 9:00am – 5:00pm")
  updatedAt       DateTime @updatedAt
}

/// Singleton row (id always "home") for all editable homepage copy.
/// No field defaults here (aside from id): MySQL doesn't allow default values on
/// TEXT/JSON columns, and every field is always supplied explicitly by the seed
/// script and the admin update action anyway.
model HomePage {
  id                     String   @id @default("home")
  heroEyebrow            String
  heroHeadline           String
  heroSubheadline        String   @db.Text
  heroPrimaryCta         String
  heroSecondaryCta       String
  heroImage              String
  trustBarItems          Json
  valuePropTitle         String
  valuePropBody          Json
  practiceOverviewTitle  String
  practiceOverviewCta    String
  whyChooseUsTitle       String
  whyChooseUsIntro       String   @db.Text
  whyChooseUsItems       Json
  aboutPreviewTitle      String
  aboutPreviewBody       String   @db.Text
  aboutPreviewImage      String
  aboutPreviewCta        String
  finalCtaTitle          String
  finalCtaBody           String   @db.Text
  finalCtaPrimary        String
  finalCtaSecondary      String
  updatedAt              DateTime @updatedAt
}

/// Singleton row (id always "about") for the About page. See HomePage note above
/// re: no field defaults (MySQL TEXT/JSON columns can't have them).
model AboutPage {
  id                  String   @id @default("about")
  heroTitle           String
  heroSubtitle        String
  intro               String   @db.Text
  storyTitle          String
  storyBody           String   @db.Text
  missionText         String   @db.Text
  visionText          String   @db.Text
  philosophyTitle     String
  philosophyBody      String   @db.Text
  philosophyQuestions Json
  approachItems       Json
  whoWeServeItems     Json
  globalTitle         String
  globalBody          String   @db.Text
  globalPoints        Json
  standardTitle       String
  standardIntro       String   @db.Text
  standardPoints      Json
  closingBody         String   @db.Text
  updatedAt           DateTime @updatedAt
}

model PracticeArea {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  slug           String   @unique
  shortTitle     String
  title          String
  tagline        String   @db.Text
  intro          String   @db.Text
  servicesTitle  String   @default("Our Services")
  services       Json
  mattersTitle   String   @default("Representative Matters")
  matters        Json
  whyTitle       String   @default("Why Clients Choose Us")
  whyItems       Json
  extraSections  Json
  closingTitle   String   @default("Let's Talk About Your Matter")
  closingBody    String   @db.Text
  ctaLabel       String   @default("Schedule a Confidential Consultation")
  heroImage      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Partner {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  name           String
  credentials    String   @default("Esq.")
  title          String
  photoUrl       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  bio            String   @db.Text
  quote          String   @db.Text
  practiceFocus  Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Singleton row (id always "contact") for the Contact / Consultation page.
model ContactPage {
  id           String   @id @default("contact")
  heroTitle    String
  heroSubtitle String   @db.Text
  formIntro    String   @db.Text
  updatedAt    DateTime @updatedAt
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String   @default("")
  company      String   @default("")
  practiceArea String   @default("")
  message      String   @db.Text
  createdAt    DateTime @default(now())
  read         Boolean  @default(false)
}
